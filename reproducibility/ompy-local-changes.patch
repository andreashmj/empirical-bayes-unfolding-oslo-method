+def _row_normalize_support(values: np.ndarray, support: np.ndarray) -> np.ndarray:
+    out = np.where(support, values, 0.0).astype(np.float32, copy=False)
+    row_sum = out.sum(axis=1, keepdims=True)
+    row_sum = np.where(row_sum > 0.0, row_sum, 1.0)
+    return out / row_sum
+
+
+def _mid_to_edges(x: np.ndarray) -> np.ndarray:
+    x = np.asarray(x, dtype=np.float32)
+    if x.size < 2:
+        raise ValueError('Need at least two points.')
+    edges = np.empty(x.size + 1, dtype=np.float32)
+    edges[1:-1] = 0.5 * (x[:-1] + x[1:])
+    edges[0] = x[0] - 0.5 * (x[1] - x[0])
+    edges[-1] = x[-1] + 0.5 * (x[-1] - x[-2])
+    return edges
+
+
+def _uniform_axis_from_matrix(FG: Matrix) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    Ex = np.asarray(FG.Ex, dtype=np.float32)
+    Eg = np.asarray(FG.Eg, dtype=np.float32)
+    dEx = float(np.median(np.diff(Ex)))
+    dEg = float(np.median(np.diff(Eg)))
+    dEf = min(abs(dEx), abs(dEg))
+    Ef_min = 0.0
+    Ef_max = max(float(Ex.max() - Eg.min()), dEf)
+    Ef = np.arange(Ef_min, Ef_max + 0.5 * dEf, dEf, dtype=np.float32)
+    return Ex, Eg, Ef
